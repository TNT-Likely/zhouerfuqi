{
  "expo": {
    "name": "RosterWake",
    "slug": "zhouerfuqi",
    "version": "0.4.0",
    "scheme": "zhouerfuqi",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "newArchEnabled": true,
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android"
    ],
    "locales": {
      "zh-Hans": "./locales/zh-Hans.json"
    },
    "ios": {
      "bundleIdentifier": "com.tntlikely.zhouerfuqi",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "NSAlarmKitUsageDescription": "RosterWake uses system alarms to ring at the times in your shift schedule.",
        "NSPhotoLibraryUsageDescription": "Choose a photo to use as your avatar on the RosterWake home screen.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.tntlikely.zhouerfuqi",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-localization",
        {
          "supportsRTL": false,
          "supportedLocales": {
            "ios": ["en", "zh-Hans"],
            "android": ["en", "zh-Hans"]
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo to use as your avatar on the RosterWake home screen.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
